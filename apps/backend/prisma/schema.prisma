generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum estado_negocio {
  activo
  suspendido
  cancelado
}

enum estado_plan {
  activo
  inactivo
}

enum estado_suscripcion {
  activa
  pago_fallido
  cancelada
  suspendida
}

enum rol_usuario {
  propietario
  administrador
  cobrador
  soporte
  admin_plataforma
}

enum estado_usuario {
  activo
  inactivo
}

enum estado_cliente {
  activo
  inactivo
}

enum periodicidad_credito {
  diaria
  semanal
  quincenal
  mensual
}

enum estado_credito {
  activo
  pagado
  mora
  anulado
  refinanciado
}

enum estado_cuota {
  pendiente
  pagada
  parcial
  mora
  anulada
}

enum estado_asignacion {
  activa
  finalizada
}

enum metodo_pago {
  efectivo
  transferencia
  nequi
  daviplata
  otro
}

enum estado_pago {
  valido
  anulado
}

model Negocio {
  id                 String         @id @default(uuid()) @db.Uuid
  nombreComercial    String         @map("nombre_comercial") @db.VarChar(180)
  razonSocial        String?        @map("razon_social") @db.VarChar(180)
  documentoFiscal    String?        @map("documento_fiscal") @db.VarChar(40)
  moneda             String         @default("COP") @db.Char(3)
  estado             estado_negocio @default(activo)
  configuracion      Json           @default("{}")
  fechaCreacion      DateTime       @default(now()) @map("fecha_creacion") @db.Timestamptz(6)
  fechaActualizacion DateTime       @updatedAt @map("fecha_actualizacion") @db.Timestamptz(6)
  usuarios           Usuario[]
  clientes           Cliente[]
  creditos           Credito[]
  cuotas             Cuota[]
  asignaciones       Asignacion[]
  pagos              Pago[]
  auditorias         Auditoria[]
  suscripcion        Suscripcion?

  @@index([estado])
  @@map("negocios")
}

model Usuario {
  id                 String         @id @default(uuid()) @db.Uuid
  negocioId          String?        @map("negocio_id") @db.Uuid
  nombre             String         @db.VarChar(160)
  correo             String         @unique @db.VarChar(180)
  hashContrasena     String         @map("hash_contrasena") @db.VarChar(255)
  rol                rol_usuario
  estado             estado_usuario @default(activo)
  telefono           String?        @db.VarChar(30)
  fechaCreacion      DateTime       @default(now()) @map("fecha_creacion") @db.Timestamptz(6)
  ultimoAcceso       DateTime?      @map("ultimo_acceso") @db.Timestamptz(6)
  fechaActualizacion DateTime       @updatedAt @map("fecha_actualizacion") @db.Timestamptz(6)
  negocio                     Negocio?      @relation(fields: [negocioId], references: [id], onDelete: Restrict)
  clientesCreados             Cliente[]     @relation("ClientesCreados")
  creditosCreados             Credito[]     @relation("CreditosCreados")
  asignacionesComoCobrador    Asignacion[]  @relation("AsignacionesCobrador")
  asignacionesCreadas         Asignacion[]  @relation("AsignacionesAsignadoPor")
  pagosRegistrados            Pago[]        @relation("PagosCobrador")
  pagosAnulados               Pago[]        @relation("PagosAnuladoPor")
  auditorias                  Auditoria[]

  @@index([negocioId])
  @@index([rol])
  @@index([estado])
  @@map("usuarios")
}

model Cliente {
  id                  String         @id @default(uuid()) @db.Uuid
  negocioId           String         @map("negocio_id") @db.Uuid
  nombreCompleto      String         @map("nombre_completo") @db.VarChar(180)
  tipoDocumento       String         @map("tipo_documento") @db.VarChar(20)
  numeroDocumento     String         @map("numero_documento") @db.VarChar(40)
  telefono            String         @db.VarChar(30)
  direccion           String         @db.VarChar(220)
  barrio              String         @db.VarChar(120)
  referenciaUbicacion String?        @map("referencia_ubicacion") @db.VarChar(220)
  estado              estado_cliente @default(activo)
  fechaCreacion       DateTime       @default(now()) @map("fecha_creacion") @db.Timestamptz(6)
  fechaActualizacion  DateTime       @updatedAt @map("fecha_actualizacion") @db.Timestamptz(6)
  creadoPor           String         @map("creado_por") @db.Uuid
  negocio             Negocio        @relation(fields: [negocioId], references: [id], onDelete: Restrict)
  creador             Usuario        @relation("ClientesCreados", fields: [creadoPor], references: [id], onDelete: Restrict)
  creditos            Credito[]

  @@unique([negocioId, tipoDocumento, numeroDocumento])
  @@index([negocioId])
  @@index([negocioId, nombreCompleto])
  @@index([negocioId, telefono])
  @@index([creadoPor])
  @@map("clientes")
}

model Plan {
  id                   String        @id @default(uuid()) @db.Uuid
  codigo               String        @unique @db.VarChar(40)
  nombre               String        @db.VarChar(80)
  limiteCobradores     Int           @map("limite_cobradores")
  precioImplementacion Decimal       @map("precio_implementacion") @db.Decimal(18, 2)
  precioMensual        Decimal       @map("precio_mensual") @db.Decimal(18, 2)
  caracteristicas      Json          @default("{}")
  estado               estado_plan   @default(activo)
  fechaCreacion        DateTime      @default(now()) @map("fecha_creacion") @db.Timestamptz(6)
  suscripciones        Suscripcion[]

  @@map("planes")
}

model Suscripcion {
  id                     String              @id @default(uuid()) @db.Uuid
  negocioId              String              @unique @map("negocio_id") @db.Uuid
  planId                 String              @map("plan_id") @db.Uuid
  estado                 estado_suscripcion
  fechaInicio            DateTime            @map("fecha_inicio") @db.Date
  fechaRenovacion        DateTime            @map("fecha_renovacion") @db.Date
  fechaCancelacion       DateTime?           @map("fecha_cancelacion") @db.Date
  referenciaPagoExterno  String?             @map("referencia_pago_externo") @db.VarChar(120)
  fechaCreacion          DateTime            @default(now()) @map("fecha_creacion") @db.Timestamptz(6)
  fechaActualizacion     DateTime            @updatedAt @map("fecha_actualizacion") @db.Timestamptz(6)
  negocio                Negocio             @relation(fields: [negocioId], references: [id], onDelete: Restrict)
  plan                   Plan                @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([planId])
  @@index([estado])
  @@map("suscripciones")
}

model Credito {
  id                    String               @id @default(uuid()) @db.Uuid
  negocioId             String               @map("negocio_id") @db.Uuid
  clienteId             String               @map("cliente_id") @db.Uuid
  montoPrincipal        Decimal              @map("monto_principal") @db.Decimal(18, 2)
  tasaInteres           Decimal              @map("tasa_interes") @db.Decimal(8, 4)
  valorMora             Decimal?             @map("valor_mora") @db.Decimal(18, 2)
  periodicidad          periodicidad_credito
  numeroCuotas          Int                  @map("numero_cuotas")
  fechaDesembolso       DateTime             @map("fecha_desembolso") @db.Date
  estado                estado_credito       @default(activo)
  condicionesOriginales Json                 @map("condiciones_originales")
  fechaCreacion         DateTime             @default(now()) @map("fecha_creacion") @db.Timestamptz(6)
  fechaActualizacion    DateTime             @updatedAt @map("fecha_actualizacion") @db.Timestamptz(6)
  creadoPor             String               @map("creado_por") @db.Uuid
  negocio               Negocio              @relation(fields: [negocioId], references: [id], onDelete: Restrict)
  cliente               Cliente              @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  creador               Usuario              @relation("CreditosCreados", fields: [creadoPor], references: [id], onDelete: Restrict)
  cuotas                Cuota[]
  asignaciones          Asignacion[]
  pagos                 Pago[]

  @@index([negocioId])
  @@index([clienteId])
  @@index([estado])
  @@index([fechaDesembolso])
  @@map("creditos")
}

model Cuota {
  id              String       @id @default(uuid()) @db.Uuid
  negocioId       String       @map("negocio_id") @db.Uuid
  creditoId       String       @map("credito_id") @db.Uuid
  numeroCuota     Int          @map("numero_cuota")
  fechaVencimiento DateTime    @map("fecha_vencimiento") @db.Date
  montoEsperado   Decimal      @map("monto_esperado") @db.Decimal(18, 2)
  saldoPendiente  Decimal      @map("saldo_pendiente") @db.Decimal(18, 2)
  estado          estado_cuota @default(pendiente)
  negocio         Negocio      @relation(fields: [negocioId], references: [id], onDelete: Restrict)
  credito         Credito      @relation(fields: [creditoId], references: [id], onDelete: Restrict)
  pagos           Pago[]

  @@unique([creditoId, numeroCuota])
  @@index([negocioId])
  @@index([creditoId])
  @@index([fechaVencimiento])
  @@index([estado])
  @@index([negocioId, fechaVencimiento, estado])
  @@map("cuotas")
}

model Asignacion {
  id              String             @id @default(uuid()) @db.Uuid
  negocioId       String             @map("negocio_id") @db.Uuid
  creditoId       String             @map("credito_id") @db.Uuid
  cobradorId      String             @map("cobrador_id") @db.Uuid
  fechaAsignacion DateTime           @default(now()) @map("fecha_asignacion") @db.Timestamptz(6)
  fechaFin        DateTime?          @map("fecha_fin") @db.Timestamptz(6)
  estado          estado_asignacion  @default(activa)
  asignadoPor     String             @map("asignado_por") @db.Uuid
  negocio         Negocio            @relation(fields: [negocioId], references: [id], onDelete: Restrict)
  credito         Credito            @relation(fields: [creditoId], references: [id], onDelete: Restrict)
  cobrador        Usuario            @relation("AsignacionesCobrador", fields: [cobradorId], references: [id], onDelete: Restrict)
  asignador       Usuario            @relation("AsignacionesAsignadoPor", fields: [asignadoPor], references: [id], onDelete: Restrict)

  @@index([negocioId])
  @@index([creditoId])
  @@index([cobradorId])
  @@index([estado])
  @@index([negocioId, cobradorId, estado])
  @@map("asignaciones")
}

model Pago {
  id              String       @id @default(uuid()) @db.Uuid
  negocioId       String       @map("negocio_id") @db.Uuid
  cuotaId         String       @map("cuota_id") @db.Uuid
  creditoId       String       @map("credito_id") @db.Uuid
  cobradorId      String       @map("cobrador_id") @db.Uuid
  monto           Decimal      @db.Decimal(18, 2)
  fechaPago       DateTime     @map("fecha_pago") @db.Timestamptz(6)
  metodoPago      metodo_pago  @map("metodo_pago")
  estado          estado_pago  @default(valido)
  motivoAnulacion String?      @map("motivo_anulacion") @db.VarChar(240)
  anuladoPor      String?      @map("anulado_por") @db.Uuid
  fechaAnulacion  DateTime?    @map("fecha_anulacion") @db.Timestamptz(6)
  fechaCreacion   DateTime     @default(now()) @map("fecha_creacion") @db.Timestamptz(6)
  negocio         Negocio      @relation(fields: [negocioId], references: [id], onDelete: Restrict)
  cuota           Cuota        @relation(fields: [cuotaId], references: [id], onDelete: Restrict)
  credito         Credito      @relation(fields: [creditoId], references: [id], onDelete: Restrict)
  cobrador        Usuario      @relation("PagosCobrador", fields: [cobradorId], references: [id], onDelete: Restrict)
  anulador        Usuario?     @relation("PagosAnuladoPor", fields: [anuladoPor], references: [id], onDelete: Restrict)

  @@index([negocioId])
  @@index([creditoId])
  @@index([cuotaId])
  @@index([cobradorId])
  @@index([fechaPago])
  @@index([estado])
  @@index([negocioId, fechaPago, estado])
  @@map("pagos")
}

model Auditoria {
  id        String   @id @default(uuid()) @db.Uuid
  negocioId String?  @map("negocio_id") @db.Uuid
  usuarioId String   @map("usuario_id") @db.Uuid
  entidad   String   @db.VarChar(60)
  entidadId String   @map("entidad_id") @db.Uuid
  accion    String   @db.VarChar(40)
  detalle   Json     @default("{}")
  fecha     DateTime @default(now()) @db.Timestamptz(6)
  ipOrigen  String?  @map("ip_origen") @db.VarChar(45)
  negocio   Negocio? @relation(fields: [negocioId], references: [id], onDelete: Restrict)
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([negocioId])
  @@index([usuarioId])
  @@index([entidad, entidadId])
  @@index([fecha])
  @@map("auditorias")
}
