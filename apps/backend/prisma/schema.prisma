generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum estado_negocio {
  activo
  suspendido
  cancelado
}

enum estado_plan {
  activo
  inactivo
}

enum rol_usuario {
  propietario
  administrador
  cobrador
  soporte
  admin_plataforma
}

enum estado_usuario {
  activo
  inactivo
}

enum estado_cliente {
  activo
  inactivo
}

model Negocio {
  id                 String         @id @default(uuid()) @db.Uuid
  nombreComercial    String         @map("nombre_comercial") @db.VarChar(180)
  razonSocial        String?        @map("razon_social") @db.VarChar(180)
  documentoFiscal    String?        @map("documento_fiscal") @db.VarChar(40)
  moneda             String         @default("COP") @db.Char(3)
  estado             estado_negocio @default(activo)
  configuracion      Json           @default("{}")
  fechaCreacion      DateTime       @default(now()) @map("fecha_creacion") @db.Timestamptz(6)
  fechaActualizacion DateTime       @updatedAt @map("fecha_actualizacion") @db.Timestamptz(6)
  usuarios           Usuario[]
  clientes           Cliente[]

  @@index([estado])
  @@map("negocios")
}

model Usuario {
  id                 String         @id @default(uuid()) @db.Uuid
  negocioId          String?        @map("negocio_id") @db.Uuid
  nombre             String         @db.VarChar(160)
  correo             String         @unique @db.VarChar(180)
  hashContrasena     String         @map("hash_contrasena") @db.VarChar(255)
  rol                rol_usuario
  estado             estado_usuario @default(activo)
  telefono           String?        @db.VarChar(30)
  fechaCreacion      DateTime       @default(now()) @map("fecha_creacion") @db.Timestamptz(6)
  ultimoAcceso       DateTime?      @map("ultimo_acceso") @db.Timestamptz(6)
  fechaActualizacion DateTime       @updatedAt @map("fecha_actualizacion") @db.Timestamptz(6)
  negocio            Negocio?       @relation(fields: [negocioId], references: [id], onDelete: Restrict)
  clientesCreados    Cliente[]      @relation("ClientesCreados")

  @@index([negocioId])
  @@index([rol])
  @@index([estado])
  @@map("usuarios")
}

model Cliente {
  id                  String         @id @default(uuid()) @db.Uuid
  negocioId           String         @map("negocio_id") @db.Uuid
  nombreCompleto      String         @map("nombre_completo") @db.VarChar(180)
  tipoDocumento       String         @map("tipo_documento") @db.VarChar(20)
  numeroDocumento     String         @map("numero_documento") @db.VarChar(40)
  telefono            String         @db.VarChar(30)
  direccion           String?        @db.VarChar(220)
  referenciaUbicacion String?        @map("referencia_ubicacion") @db.VarChar(220)
  estado              estado_cliente @default(activo)
  fechaCreacion       DateTime       @default(now()) @map("fecha_creacion") @db.Timestamptz(6)
  fechaActualizacion  DateTime       @updatedAt @map("fecha_actualizacion") @db.Timestamptz(6)
  creadoPor           String         @map("creado_por") @db.Uuid
  negocio             Negocio        @relation(fields: [negocioId], references: [id], onDelete: Restrict)
  creador             Usuario        @relation("ClientesCreados", fields: [creadoPor], references: [id], onDelete: Restrict)

  @@unique([negocioId, tipoDocumento, numeroDocumento])
  @@index([negocioId])
  @@index([negocioId, nombreCompleto])
  @@index([negocioId, telefono])
  @@index([creadoPor])
  @@map("clientes")
}

model Plan {
  id                   String      @id @default(uuid()) @db.Uuid
  codigo               String      @unique @db.VarChar(40)
  nombre               String      @db.VarChar(80)
  limiteCobradores     Int         @map("limite_cobradores")
  precioImplementacion Decimal     @map("precio_implementacion") @db.Decimal(18, 2)
  precioMensual        Decimal     @map("precio_mensual") @db.Decimal(18, 2)
  caracteristicas      Json        @default("{}")
  estado               estado_plan @default(activo)
  fechaCreacion        DateTime    @default(now()) @map("fecha_creacion") @db.Timestamptz(6)

  @@map("planes")
}
