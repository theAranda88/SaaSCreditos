# Creditos SaaS — variables para Docker Compose y desarrollo local
# Copiar a .env: cp .env.example .env

# PostgreSQL
POSTGRES_USER=creditos
POSTGRES_PASSWORD=creditos_dev
POSTGRES_DB=creditos
# Puerto en el HOST (DBeaver, Prisma local). 5433 evita conflicto con PostgreSQL nativo en Windows (5432).
POSTGRES_PORT=5433

# Backend (NestJS)
API_PORT=3000
NODE_ENV=development
JWT_SECRETO=dev_secreto_minimo_32_caracteres_local

# Frontend (Angular en nginx dentro de Docker)
FRONT_PORT=4200

# Prisma en el HOST (migrate dev, scripts locales)
# Dentro de Docker Compose se usa postgres:5432 automaticamente via db-init/backend
DATABASE_URL=postgresql://creditos:creditos_dev@localhost:5433/creditos?schema=public
