                  "  pm.environment.set('cobrador_id', json.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Listar cobradores",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/cobradores?nombre=Carlos&estado=activo",
            "description": "Roles: propietario, administrador. Solo usuarios con rol cobrador del negocio."
          }
        },
        {
          "name": "Obtener cobrador por ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/cobradores/{{cobrador_id}}",
            "description": "Roles: propietario, administrador. Id de otro negocio → 404."
          }
        },
        {
          "name": "Actualizar cobrador",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"telefono\": \"3009876543\"\n}"
            },
            "url": "{{base_url}}/cobradores/{{cobrador_id}}",
            "description": "Roles: propietario, administrador. No cambia el rol ni negocio_id."
          }
        },
        {
          "name": "Cambiar estado del cobrador",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"inactivo\"\n}"
            },
            "url": "{{base_url}}/cobradores/{{cobrador_id}}/estado",
            "description": "Roles: propietario, administrador. Inactiva sin borrar histórico."
          }
        }
      ]
    },
    {
      "name": "Creditos",
      "description": "Alta de créditos y plan de cuotas (RF-005, RF-006, RF-014). Roles: propietario, administrador.",
      "item": [
        {
          "name": "Crear credito",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clienteId\": \"{{cliente_id}}\",\n  \"montoPrincipal\": 100000,\n  \"tasaInteres\": 20,\n  \"valorMora\": 5000,\n  \"periodicidad\": \"diaria\",\n  \"numeroCuotas\": 20,\n  \"fechaDesembolso\": \"2026-09-16\"\n}"
            },
            "url": "{{base_url}}/creditos",
            "description": "Roles: propietario, administrador. Crea crédito + cuotas + auditoría en una transacción. condiciones_originales inmutable. Cobrador → 403. Cliente inactivo → 422."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  pm.environment.set('credito_id', json.credito.id);",
                  "  if (json.cuotas && json.cuotas[0]) {",
                  "    pm.environment.set('cuota_id', json.cuotas[0].id);",
                  "  }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Listar creditos",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/creditos?estado=activo",
            "description": "Roles: propietario, administrador. Filtra por negocio_id del token."
          }
        },
        {
          "name": "Obtener credito por ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/creditos/{{credito_id}}",
            "description": "Roles: propietario, administrador. Incluye condiciones_originales. Id de otro negocio → 404."
          }
        },
        {
          "name": "Consultar plan de cuotas",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/creditos/{{credito_id}}/cuotas",
            "description": "Roles: propietario, administrador. Plan ordenado por numero_cuota. Otro negocio → 404."
          }
        }
      ]
    },
    {
      "name": "Asignaciones",
      "description": "Asignación y reasignación de cartera (RF-007). Admin asigna; cobrador lista solo la suya.",
      "item": [
        {
          "name": "Asignar cartera",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"creditoId\": \"{{credito_id}}\",\n  \"cobradorId\": \"{{cobrador_id}}\"\n}"
            },
            "url": "{{base_url}}/asignaciones",
            "description": "Roles: propietario, administrador. Primera asignación o reasignación atómica. Cobrador → 403. Cobrador inactivo / crédito no asignable → 422."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  pm.environment.set('asignacion_id', json.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Listar asignaciones",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/asignaciones?cobradorId={{cobrador_id}}&estado=activa",
            "description": "Admin filtra por cobrador/crédito/estado. Cobrador ve solo sus asignaciones activas."
          }
        },
        {
          "name": "Obtener asignacion por ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/asignaciones/{{asignacion_id}}",
            "description": "Roles: propietario, administrador, cobrador. Cartera de otro cobrador → 403. Otro negocio → 404."
          }
        }
      ]
    },
    {
      "name": "Planes",
      "description": "Catálogo comercial global (RF-015 / RA-004).",
      "item": [
        {
          "name": "Listar planes",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/planes",
            "description": "Roles de negocio ven planes activos. Plataforma ve el catálogo completo."
          }
        }
      ]
    },
    {
      "name": "Suscripciones",
      "description": "Consulta y checkout stub de la suscripción del negocio (RF-015).",
      "item": [
        {
          "name": "Consultar mi suscripcion",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/suscripciones/mia",
            "description": "Roles propietario/administrador. Disponible aunque el negocio esté suspendido."
          },
          "event": [
            {
              "listen": "test",
              "script": {
