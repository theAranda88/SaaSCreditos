        {
          "name": "Checkout stub",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"planId\": \"{{plan_id}}\",\n  \"referenciaPagoExterno\": \"stub-checkout-001\"\n}"
            },
            "url": "{{base_url}}/suscripciones/checkout-stub",
            "description": "Solo propietario. 422 si el cupo no cabe en el plan destino."
